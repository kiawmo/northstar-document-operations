# Export these settings in your shell for a native gateway; never commit real keys.
LLM_PROVIDER=codex_cli
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
GATEWAY_API_KEY=
ALLOW_PAID_LLM=false
CODEX_EXECUTABLE=
CODEX_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_CONCURRENCY=2
# Paid adapters are explicit opt-ins and require operator-owned credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
